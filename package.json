{
  "name": "hoursflow-business-hours-cta",
  "version": "0.1.0",
  "private": true,
  "description": "Build and test tooling for HoursFlow — Business Hours CTA for WordPress.",
  "scripts": {
    "audit:production": "pnpm audit --prod --audit-level high",
    "build": "wp-scripts build",
    "build:check": "node tools/check-build.js",
    "check": "node tools/check.js",
    "format": "prettier --write --paren-spacing --config node_modules/@wordpress/prettier-config/lib/index.js assets/admin/settings.js assets/admin/settings.test.js src/blocks/cta tools/*.js",
    "format:check": "prettier --check --paren-spacing --config node_modules/@wordpress/prettier-config/lib/index.js assets/admin/settings.js assets/admin/settings.test.js src/blocks/cta tools/*.js",
    "i18n:pot": "node tools/make-pot.js",
    "i18n:pot:check": "node tools/check-pot.js",
    "lint:css": "npm run lint:style",
    "lint:js": "wp-scripts lint-js src/blocks/cta assets/admin/settings.js assets/admin/settings.test.js tools",
    "lint:style": "wp-scripts lint-style \"assets/**/*.css\" \"src/**/*.scss\" --custom-syntax postcss-scss",
    "package": "node tools/package.js",
    "package:check": "node tools/package.js --check",
    "test:js": "wp-scripts test-unit-js --runInBand",
    "test:unit": "npm run test:js"
  },
  "devDependencies": {
    "@wordpress/blocks": "13.0.3",
    "@wordpress/prettier-config": "4.55.0",
    "@wordpress/scripts": "28.0.2",
    "typescript": "5.4.5",
    "wp-prettier": "2.8.5",
    "yazl": "3.3.1"
  }
}
