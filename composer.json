{
    "name": "opennow/opennow-cta",
    "description": "A lightweight WordPress CTA foundation driven by business hours.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "OpenNow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenNow\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
