<?xml version="1.0"?>
<ruleset name="HoursFlow">
    <description>WordPress coding standards for the HoursFlow runtime.</description>

    <arg name="basepath" value="." />
    <arg name="colors" />
    <arg name="parallel" value="8" />
    <arg value="p" />

    <config name="minimum_supported_wp_version" value="6.6" />
    <config name="testVersion" value="7.4-" />

    <rule ref="WordPress">
        <!-- PSR-4 class filenames and WordPress callback names are public contracts. -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
        <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid" />
        <!-- Existing public APIs use concise PHPDoc type annotations where needed. -->
        <exclude name="Squiz.Commenting.FileComment.Missing" />
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag" />
        <exclude name="Squiz.Commenting.FunctionComment.Missing" />
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment" />
        <exclude name="Generic.Commenting.DocComment.MissingShort" />
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.*" />
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="hoursflow" />
                <element value="HoursFlow" />
                <element value="HOURSFLOW" />
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="hoursflow" />
            </property>
        </properties>
    </rule>

    <file>hoursflow.php</file>
    <file>uninstall.php</file>
    <file>src</file>

    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/src/blocks/cta/*.js</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <exclude-pattern>/build/</exclude-pattern>
    <exclude-pattern>/dist/</exclude-pattern>
</ruleset>
