{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "opennow/cta",
	"title": "OpenNow CTA",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Show the right call to action based on the current business state, with optional per-state content and status visibility.",
	"keywords": [ "call to action", "business hours", "open now" ],
	"textdomain": "opennow",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"attributes": {
		"overrides": {
			"type": "object"
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"color": {
			"text": true,
			"background": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	}
}
